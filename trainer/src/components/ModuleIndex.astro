---
import Base from '../layouts/Base.astro';
import { MODULES, taskUrl, url } from '../lib/data';
interface Props { mod: 'excel' | 'sql' | 'bi'; h1: string; lead: string; title: string; description: string }
const { mod, h1, lead, title, description } = Astro.props;
const { tracks, tasks } = MODULES[mod].data;
const first = tasks[0];
let k = 0;
---
<Base title={title} description={description} path={mod + '/'} mod={mod} jsonld={[{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Тренажёр', item: 'https://xlplain.ru/trenazher/' }, { '@type': 'ListItem', position: 2, name: MODULES[mod].name }] }]}>
  <div class="hub">
    <p class="bc"><a href={url()}>Тренажёр</a> / {MODULES[mod].name}</p>
    <h1>{h1}</h1>
    <p class="lead">{lead}</p>
    <slot />
    <p><a class="btn main" style="margin-left:0" href={taskUrl(mod, first.slug)} id="continue" data-mod={mod} data-list={JSON.stringify(tasks.map((t: any) => [t.id, t.slug]))} data-base={url()}>Начать с первой задачи →</a></p>
    <div class="tracks">
      {tracks.map((tr: any) => (
        <section class="track">
          <h2>{tr.name}</h2>
          <ol>
            {tasks.filter((t: any) => t.track === tr.id).map((t: any) => { k++; return (
              <li><a href={taskUrl(mod, t.slug)} data-task={t.id}><span class="dot">{k}</span><span class="tt">{t.title}<small>{t.fn || ({ number: 'расчёт', choice: 'выбор ответа', order: 'порядок шагов', dax: 'мера DAX', pq: 'редактор Power Query' } as any)[t.check]}</small></span></a></li>
            ); })}
          </ol>
        </section>
      ))}
    </div>
  </div>
</Base>
