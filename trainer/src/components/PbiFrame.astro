---
// Оболочка «Power BI Desktop»: лента, строка формул, холст, панели «Визуализации» и «Данные».
interface Props { file?: string }
const { file = 'Продажи' } = Astro.props;
---
<div class="pbi" id="pbi">
  <div class="pbi-title">
    <span class="pbi-logo" aria-hidden="true"><i></i><i></i><i></i></span>
    <span><b>{file}</b> — Power BI Desktop</span>
    <span class="pbi-tag">тренажёр XLPlain</span>
    <button class="pbi-full" id="full" title="Развернуть на весь экран" aria-label="Развернуть на весь экран">⤢</button>
  </div>
  <div class="pbi-tabs" role="tablist"><span>Файл</span><span>Главная</span><span>Вставка</span><span class="on">Моделирование</span><span>Вид</span><span>Справка</span></div>
  <div class="pbi-ribbon">
    <div class="rg">
      <div class="rb">
        <button class="big" id="newm" title="Новая мера"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2" fill="#fff" stroke="#605e5c"/><rect x="7" y="6" width="10" height="3" fill="#c8c6c4"/><g fill="#605e5c"><rect x="7" y="11" width="2" height="2"/><rect x="11" y="11" width="2" height="2"/><rect x="15" y="11" width="2" height="2"/><rect x="7" y="15" width="2" height="2"/><rect x="11" y="15" width="2" height="2"/></g><circle cx="18" cy="18" r="4.5" fill="#f2c811"/><path d="M18 15.6v4.8M15.6 18h4.8" stroke="#252423" stroke-width="1.4"/></svg><span>Новая<br>мера</span></button>
        <button class="big" disabled title="В тренажёре недоступно"><svg viewBox="0 0 24 24"><path d="M13 2 5 14h6l-1 8 8-12h-6z" fill="#c8c6c4"/></svg><span>Быстрая<br>мера</span></button>
        <button class="big" disabled title="В тренажёре недоступно"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" fill="#fff" stroke="#c8c6c4"/><path d="M9 4v16M15 4v16" stroke="#c8c6c4"/></svg><span>Новый<br>столбец</span></button>
      </div>
      <div class="rl">Вычисления</div>
    </div>
    <div class="rg">
      <div class="rb col">
        <label class="rf">Имя <input id="mname" readonly value=""></label>
        <label class="rf">Таблица <select disabled><option>Продажи</option></select></label>
      </div>
      <div class="rl">Структура</div>
    </div>
    <div class="rg">
      <div class="rb col">
        <label class="rf">Формат <select id="fmt"><option value="">Общий</option><option value="int">Целое число</option><option value="dec2">Десятичное число</option><option value="percent">Процент</option><option value="rub">Валюта</option></select></label>
        <div class="rf fmt-btns" aria-hidden="true"><span>₽</span><span>%</span><span>000</span><span>,0</span></div>
      </div>
      <div class="rl">Форматирование</div>
    </div>
    <div class="rg grow">
      <div class="rb">
        <button class="big go" id="check"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#1d6b45"/><path d="m7 12.5 3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.2"/></svg><span>Проверить<br>решение</span></button>
        <button class="big" id="hintb"><svg viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0-3.5 10.9V17h7v-3.1A6 6 0 0 0 12 3z" fill="#fff3c4" stroke="#8a6d00"/><path d="M9.5 19.5h5M10.5 21.5h3" stroke="#8a6d00"/></svg><span>Подсказка</span></button>
        <button class="big" id="solb"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2" fill="#fff" stroke="#605e5c"/><path d="M8 8h8M8 12h8M8 16h5" stroke="#605e5c"/></svg><span>Показать<br>решение</span></button>
      </div>
      <div class="rl">Тренажёр</div>
    </div>
  </div>
  <div class="pbi-fx">
    <button class="fxb x" id="fxx" title="Отменить изменения (Esc)">✕</button>
    <button class="fxb ok" id="fxok" title="Зафиксировать (Enter)">✓</button>
    <div id="ed" class="fxed"></div>
  </div>
  <div class="pbi-err" id="err" hidden></div>
  <div class="pbi-body">
    <nav class="pbi-rail" aria-label="Представления">
      <button class="on" data-view="report" title="Отчёт"><svg viewBox="0 0 24 24"><rect x="4" y="12" width="3.5" height="8" fill="currentColor"/><rect x="10" y="7" width="3.5" height="13" fill="currentColor"/><rect x="16" y="4" width="3.5" height="16" fill="currentColor"/></svg></button>
      <button data-view="table" title="Представление таблицы"><svg viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="15" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 9.5h17M3.5 14.5h17M9.5 4.5v15" stroke="currentColor" stroke-width="1.4"/></svg></button>
      <button data-view="model" title="Представление модели"><svg viewBox="0 0 24 24"><rect x="2.5" y="3" width="7" height="6" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="14.5" y="3" width="7" height="6" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="8.5" y="15" width="7" height="6" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M6 9l4.5 6M18 9l-4.5 6" stroke="currentColor" stroke-width="1.4"/></svg></button>
    </nav>
    <div class="pbi-canvas" id="canvas">
      <div class="pbi-page" id="v-report"></div>
      <div class="pbi-grid" id="v-table" hidden></div>
      <div class="pbi-model" id="v-model" hidden></div>
    </div>
    <div class="pbi-panes">
      <section class="pane">
        <h4>Визуализации</h4>
        <div class="vicons" aria-hidden="true">
          <span title="Гистограмма"><svg viewBox="0 0 16 16"><rect x="2" y="8" width="3" height="6"/><rect x="6.5" y="4" width="3" height="10"/><rect x="11" y="6" width="3" height="8"/></svg></span>
          <span title="Карточка"><svg viewBox="0 0 16 16"><rect x="1.5" y="3.5" width="13" height="9" fill="none" stroke="currentColor"/><text x="8" y="11" font-size="6" text-anchor="middle">123</text></svg></span>
          <span class="on" title="Матрица"><svg viewBox="0 0 16 16"><rect x="1.5" y="2.5" width="13" height="11" fill="none" stroke="currentColor"/><path d="M1.5 6h13M1.5 9.5h13M6 2.5v11" stroke="currentColor"/></svg></span>
          <span title="Срез"><svg viewBox="0 0 16 16"><path d="M2 3h12l-4.5 5v5l-3-1.5V8z" fill="none" stroke="currentColor"/></svg></span>
        </div>
        <div class="well" data-well="rows"><label>Строки</label><div class="slots" id="w-rows"></div></div>
        <div class="well" data-well="values"><label>Значения</label><div class="slots" id="w-values"></div></div>
        <p class="pane-note">Отметьте поле в панели «Данные» или перетащите его сюда. Поле можно перетащить и в строку формул.</p>
      </section>
      <section class="pane">
        <h4>Данные</h4>
        <input class="search" id="fsearch" placeholder="Поиск" autocomplete="off">
        <div id="fields" class="fields"></div>
      </section>
    </div>
  </div>
  <div class="pbi-status"><span id="st">Страница 1 из 1</span><span>Модель считается в вашем браузере</span></div>
</div>
