---
import Base from '../../layouts/Base.astro';
import Aside from '../../components/Aside.astro';
import PbiFrame from '../../components/PbiFrame.astro';
import PqFrame from '../../components/PqFrame.astro';
import { MODULES, taskUrl, url, neighbours, trackOf } from '../../lib/data';
export function getStaticPaths() { return MODULES.bi.data.tasks.map((t: any) => ({ params: { slug: t.slug }, props: { task: t } })); }
const { task } = Astro.props as any;
const { i, n, prev, next } = neighbours('bi', task.id);
const tr = trackOf('bi', task);
// детерминированное перемешивание: одинаковое при каждой сборке, верный ответ не всегда первый
let seed = [...task.id].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
const rnd = () => { seed = (seed * 1103515245 + 12345) >>> 0; return seed / 4294967296; };
const shuffle = (a: any[]) => { const b = a.map((x, k) => ({ x, k })); for (let j = b.length - 1; j > 0; j--) { const r = Math.floor(rnd() * (j + 1)); [b[j], b[r]] = [b[r], b[j]]; } return b; };
let options = task.check === 'choice' ? shuffle(task.options) : [];
if (options.length && options[0].x.correct) options = [...options.slice(1, 3), options[0], ...options.slice(3)];
let steps = task.check === 'order' ? shuffle(task.steps) : [];
if (steps.length && steps.every((s, k) => s.k === k)) steps = [steps[1], steps[0], ...steps.slice(2)];
const kind = ({ number: 'расчёт', choice: 'выбор ответа', order: 'порядок шагов', dax: 'мера DAX', pq: 'Power Query' } as any)[task.check];
const sim = task.check === 'dax' || task.check === 'pq';
const desc = `${task.story} ${task.goal}. Кейс по Power BI с проверкой ответа и разбором.`;
const ld = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Тренажёр', item: 'https://xlplain.ru/trenazher/' },
  { '@type': 'ListItem', position: 2, name: 'Power BI', item: 'https://xlplain.ru/trenazher/bi/' },
  { '@type': 'ListItem', position: 3, name: task.title }] }];
const simTask = sim ? { id: task.id, check: task.check, xp: tr.xp, measure_name: task.measure_name, starter: task.starter, answer: task.answer, measures: task.measures, visual: task.visual, slicers: task.slicers, format: task.format, check_rows: task.check_rows, check_total: task.check_total, source: task.source, explanation: task.explanation, tip: task.tip, hint: task.hint } : null;
const clientTask = { id: task.id, check: task.check, xp: tr.xp, expected: task.expected, tolerance: task.tolerance, unit: task.unit, correct: options.findIndex((o: any) => o.x.correct), whys: options.map((o: any) => o.x.why), stepsOrder: steps.map((s: any) => s.k), hint: task.hint, tip: task.tip, explanation: task.explanation, solution: task.solution };
import '../../styles/pbi.css';
---
<Base title={task.seo_title + ' | XLPlain'} description={desc} path={`bi/${task.slug}/`} mod="bi" jsonld={ld}>
<div class={sim ? "wrap wide" : "wrap"}>
  <Aside mod="bi" current={task.id} />
  <main>
    <p class="bc"><a href={url()}>Тренажёр</a> / <a href={url('bi/')}>Power BI</a> / {tr.name}</p>
    <section class="card">
      <div class="crumbs"><span>{tr.name} · кейс {i + 1} из {n}</span><span class="chip">{kind}</span></div>
      <h1 class="h">{task.title}</h1>
      <p class="story">{task.story}</p>
      <div class="goal">{task.goal}</div>
      {task.dataset && <a class="dl" href={url('data/prodazhi.csv')} download="prodazhi.csv">⬇ Скачать датасет «Продажи» <small>CSV, разделитель «;», UTF-8</small></a>}
      {task.check === 'dax' && <PbiFrame />}
      {task.check === 'pq' && <PqFrame />}
      {task.check === 'number' && <div class="numrow"><input id="num" inputmode="decimal" autocomplete="off" placeholder="Ваш ответ" aria-label="Ответ"><span class="u">{task.unit}</span><button class="checkbtn" id="check">Проверить</button></div>}
      {task.check === 'choice' && <div class="opts">{options.map((o: any, k: number) => <button class="opt" data-k={k}><span class="l">{'АБВГД'[k]}</span><span>{o.x.text}<span class="why" hidden></span></span></button>)}</div>}
      {task.check === 'order' && <><ol class="steps" id="steps">{steps.map((s: any) => <li data-k={s.k}><span class="n"></span><span class="t">{s.x}</span><button class="up" aria-label="Выше">↑</button><button class="dn" aria-label="Ниже">↓</button></li>)}</ol><div class="actions" style="margin-top:12px"><button class="btn" id="check" style="background:var(--g);color:#fff;border-color:var(--g)">Проверить порядок</button></div></>}
      <div class="fb" id="fb"></div>
      <div class="actions">
        {prev ? <a class="btn" href={taskUrl('bi', prev.slug)}>← Назад</a> : <button class="btn" disabled>← Назад</button>}
        {!sim && <button class="btn" id="hintb">Подсказка</button>}
        {task.check === 'number' && <button class="btn" id="solb">Показать решение</button>}
        {next ? <a class="btn main" id="next" href={taskUrl('bi', next.slug)} hidden>Следующий кейс →</a> : <a class="btn main" id="next" href={url()} hidden>К списку модулей →</a>}
      </div>
      <div class="note" id="hint" hidden>{task.hint}</div>
      {sim && <div class="note" id="sol" hidden>Эталонное решение (за кейс после просмотра — половина XP):<pre class="sol">{task.check === 'dax' ? task.answer : task.answer_m}</pre></div>}
      {task.check === 'number' && <div class="note" id="sol" hidden>Ответ: <b>{String(task.expected).replace('.', ',')} {task.unit}</b>{task.solution && <pre class="sol">{task.solution}</pre>}</div>}
      <p class="report">{sim ? 'Тренажёр повторяет интерфейс Power BI Desktop и считает модель прямо в браузере. Аргументы DAX можно разделять и «;», и «,» — во втором случае дробную часть пишите через точку.' : 'Формулы DAX приведены с разделителем «;», как в русском Excel. Если в вашем Power BI аргументы разделяются запятой, замените «;» на «,».'} Нашли ошибку? <a href={`mailto:support@xlplain.ru?subject=${encodeURIComponent('Ошибка в задаче тренажёра: bi/' + task.id)}`}>Напишите нам</a>.</p>
    </section>
  </main>
</div>
<script type="application/json" id="taskdata" set:html={JSON.stringify(sim ? simTask : clientTask)} />
{task.check === 'dax' ? <script>import '../../client/bi-dax';</script> : task.check === 'pq' ? <script>import '../../client/bi-pq';</script> : <script>import '../../client/bi-task';</script>}
</Base>
